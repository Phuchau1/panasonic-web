# =====================================================================
#  public/.htaccess – Clean URL cho Front Controller
# =====================================================================
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Chuyển header Authorization (nếu dùng API sau này)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # File / thư mục có thật -> phục vụ trực tiếp
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Còn lại -> index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Nén & cache tài nguyên tĩnh
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml          "access plus 1 month"
    ExpiresByType image/webp             "access plus 1 month"
    ExpiresByType image/png              "access plus 1 month"
    ExpiresByType image/jpeg             "access plus 1 month"
    ExpiresByType application/pdf        "access plus 1 week"
</IfModule>

# Chặn truy cập file nhạy cảm
<FilesMatch "\.(env|ini|log|sql|sh|bak)$">
    Require all denied
</FilesMatch>
